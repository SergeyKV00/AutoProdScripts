<Window x:Class="AutoProdScripts.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoProdScripts — Настройка"
        Height="680" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,8,0,0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    Margin="{TemplateBinding Margin}"
                    CornerRadius="3,3,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,1,0">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Сохранить и открыть" Click="Save_Click" Width="160" Margin="8,0,0,0"/>
    </StackPanel>

    <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
      <TabItem x:Name="ConnectionTab" Header="Подключение">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. Путь к ProductionScripts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Обзор…" Click="Browse_Click" Width="90" Margin="8,0,0,0"/>
          <TextBox x:Name="ProjectPathBox" />
        </DockPanel>
        <TextBlock x:Name="ProjectPathHint" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="2. Azure DevOps" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <Label Content="Org / URL"/>
        <TextBox x:Name="OrgUrlBox" Text="https://cit-damu.visualstudio.com/"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Label Content="Project"/>
            <TextBox x:Name="ProjectBox"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Repo"/>
            <TextBox x:Name="RepoBox"/>
          </StackPanel>
        </Grid>
        <Label Content="Авторизация" Margin="0,12,0,0"/>
        <TextBlock Text="Выберите, как входить в Azure DevOps." Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,8"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
          <Button x:Name="PatAuthButton" Content="PAT" Click="SelectPatAuth_Click" Margin="0,0,6,0"/>
          <Button x:Name="MicrosoftAuthButton" Content="Учётная запись Microsoft" Click="SelectMicrosoftAuth_Click" Margin="6,0,0,0"/>
        </UniformGrid>

        <StackPanel x:Name="PatPanel">
          <Label Content="PAT (Personal Access Token)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Проверить…" Click="ValidatePat_Click" Width="110" Margin="8,0,0,0"/>
            <PasswordBox x:Name="PatBox"/>
          </DockPanel>
          <TextBlock x:Name="PatHint" Text="Секрет хранится в Credential Manager / DPAPI. Для создания PR нужна область Code (Read &amp; Write), для списка ревьюверов — Project and Team (Read)." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="MicrosoftPanel" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="MicrosoftSignOutButton" DockPanel.Dock="Right" Content="Выйти" Click="MicrosoftSignOut_Click"
                    Width="90" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            <Button x:Name="MicrosoftSignInButton" DockPanel.Dock="Right" Content="Войти…" Click="MicrosoftSignIn_Click"
                    Width="110" Margin="8,0,0,0"/>
            <TextBlock x:Name="MicrosoftAccountText" Text="Вход не выполнен" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource FgBrush}"/>
          </DockPanel>
          <TextBlock x:Name="MicrosoftStatusText" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="Войдите той же учётной записью, что и на cit-damu. Окно программы при этом не блокируется: вход идёт в браузере. Сессия хранится на этом компьютере и обновляется сама." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="3. Git (нужен Git for Windows в PATH)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <TextBlock x:Name="GitHint" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <Label Content="Базовая ветка"/>
        <ComboBox x:Name="BaseBranchBox" IsEditable="True"/>
        <TextBlock Text="Выбор сохраняется между запусками." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AutoPrTab" Header="Авто PR">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Шаблон автоматического PR" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource FgBrush}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,12"
                       Text="Кнопка Auto Pull Request создаёт ветку от выбранной базы, коммитит текущие скрипты, пушит и открывает PR с этими ревьюверами."/>

            <Label Content="Базовая ветка"/>
            <ComboBox x:Name="AutoBaseBranchBox" IsEditable="True" SelectionChanged="AutoTemplate_Changed" LostFocus="AutoTemplate_Changed"/>
            <TextBlock Text="Новая ветка каждый раз создаётся от этой ветки." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,8"/>

            <Label Content="Шаблон имени ветки"/>
            <TextBox x:Name="AutoBranchTemplateBox" TextChanged="AutoTemplate_Changed"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,4"
                       Text="{}{base} — база, {yyyyMMddHHmm} — дата и время, также {yyyy} {MM} {dd} {HH} {mm}."/>
            <TextBlock x:Name="BranchPreviewText" TextWrapping="Wrap" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,12"/>

            <Label Content="Ревьюверы"/>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="Выбрать…" Click="PickAutoReviewers_Click" Width="110" Margin="8,0,0,0"/>
              <TextBlock x:Name="AutoReviewersText" Text="не выбраны" VerticalAlignment="Center" TextWrapping="Wrap"
                         Foreground="{StaticResource FgBrush}"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,12"
                       Text="Отмеченные как обязательные попадут в PR как required. Список сохраняется в шаблоне и не спрашивается при каждом Auto PR."/>

            <Label Content="Шаблон сообщения Telegram"/>
            <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Базовые шаблоны" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{StaticResource FgBrush}"/>
                <WrapPanel>
                  <Button Content="{}{text}" Tag="text" Click="InsertTelegramToken_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" ToolTip="Описание скриптов"/>
                  <Button Content="{}{link}" Tag="link" Click="InsertTelegramToken_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" ToolTip="Ссылка на PR"/>
                  <Button Content="{}{tags}" Tag="tags" Click="InsertTelegramToken_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" ToolTip="Теги людей"/>
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgInfoBrush}"
                           Text="text — описание скриптов. link — ссылка на PR, в сообщении показывается своим текстом. tags — люди из списка ниже."/>
              </StackPanel>
            </Border>
            <TextBox x:Name="TelegramTemplateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     VerticalScrollBarVisibility="Auto" TextChanged="AutoTemplate_Changed"/>

            <DockPanel Margin="0,12,0,8">
              <Button DockPanel.Dock="Right" Content="Добавить" Click="AddCustomTemplate_Click" Width="110" Margin="8,0,0,0"/>
              <TextBox x:Name="CustomTemplateNameBox" ToolTip="Имя своего шаблона, например note"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,8"
                       Text="Свой шаблон вставляется в текст как {имя}. Ниже для него напишите текст или вставьте ссылку."/>
            <StackPanel x:Name="CustomTemplatesHost"/>

            <Label Content="Кого тегать"/>
            <TextBox x:Name="TelegramTagsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                     VerticalScrollBarVisibility="Auto" TextChanged="AutoTemplate_Changed"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,8"
                       Text="По одному тегу в строке или через пробел: @ibeneyev_rus @makenty96"/>

            <Label Content="Пример сообщения"/>
            <TextBox x:Name="TelegramPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

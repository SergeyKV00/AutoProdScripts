<Window x:Class="AutoProdScripts.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoProdScripts — Настройка"
        Height="820" Width="1080"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,8,0,0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    Margin="{TemplateBinding Margin}"
                    CornerRadius="3,3,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,1,0">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Сохранить" Click="Save_Click" Width="160" Margin="8,0,0,0"/>
    </StackPanel>

    <TabControl x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
      <TabItem x:Name="ConnectionTab" Header="Подключение">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. Путь к ProductionScripts" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Content="Обзор…" Click="Browse_Click" Width="90" Margin="8,0,0,0"/>
          <TextBox x:Name="ProjectPathBox" />
        </DockPanel>
        <TextBlock x:Name="ProjectPathHint" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="2. Azure DevOps" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <Label Content="Org / URL"/>
        <TextBox x:Name="OrgUrlBox" Text="https://cit-damu.visualstudio.com/"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Label Content="Project"/>
            <TextBox x:Name="ProjectBox"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Repo"/>
            <TextBox x:Name="RepoBox"/>
          </StackPanel>
        </Grid>
        <Label Content="Авторизация" Margin="0,12,0,0"/>
        <TextBlock Text="Выберите, как входить в Azure DevOps." Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,8"/>
        <UniformGrid Columns="2" Margin="0,0,0,12">
          <Button x:Name="PatAuthButton" Content="PAT" Click="SelectPatAuth_Click" Margin="0,0,6,0"/>
          <Button x:Name="MicrosoftAuthButton" Content="Учётная запись Microsoft" Click="SelectMicrosoftAuth_Click" Margin="6,0,0,0"/>
        </UniformGrid>

        <StackPanel x:Name="PatPanel">
          <Label Content="PAT (Personal Access Token)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Проверить…" Click="ValidatePat_Click" Width="110" Margin="8,0,0,0"/>
            <PasswordBox x:Name="PatBox"/>
          </DockPanel>
          <TextBlock x:Name="PatHint" Text="Секрет хранится в Credential Manager / DPAPI. Для создания PR нужна область Code (Read &amp; Write), для списка ревьюверов — Project and Team (Read)." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="MicrosoftPanel" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="MicrosoftSignOutButton" DockPanel.Dock="Right" Content="Выйти" Click="MicrosoftSignOut_Click"
                    Width="90" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            <Button x:Name="MicrosoftSignInButton" DockPanel.Dock="Right" Content="Войти…" Click="MicrosoftSignIn_Click"
                    Width="110" Margin="8,0,0,0"/>
            <TextBlock x:Name="MicrosoftAccountText" Text="Вход не выполнен" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource FgBrush}"/>
          </DockPanel>
          <TextBlock x:Name="MicrosoftStatusText" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="" Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="3. Git (нужен Git for Windows в PATH)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{StaticResource FgBrush}"/>
        <TextBlock x:Name="GitHint" Text="" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <Label Content="Базовая ветка"/>
        <ComboBox x:Name="BaseBranchBox" IsEditable="True"/>
        <TextBlock Text="Выбор сохраняется между запусками." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AutoPrTab" Header="Авто PR">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Шаблон автоматического PR" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource FgBrush}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,12"
                       Text="Кнопка Auto Pull Request создаёт ветку от выбранной базы, коммитит текущие скрипты, пушит и открывает PR с этими ревьюверами."/>

            <Label Content="Базовая ветка"/>
            <ComboBox x:Name="AutoBaseBranchBox" IsEditable="True" SelectionChanged="AutoTemplate_Changed" LostFocus="AutoTemplate_Changed"/>
            <TextBlock Text="Новая ветка каждый раз создаётся от этой ветки." Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,8"/>

            <Label Content="Шаблон имени ветки"/>
            <TextBox x:Name="AutoBranchTemplateBox" TextChanged="AutoTemplate_Changed"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,4,0,4"
                       Text="{}{base} — база, {yyyyMMddHHmm} — дата и время, также {yyyy} {MM} {dd} {HH} {mm}."/>
            <TextBlock x:Name="BranchPreviewText" TextWrapping="Wrap" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,12"/>

            <Border Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2" CornerRadius="6" Padding="14" Margin="0,8,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="Добавить ревьюверов" Click="PickAutoReviewers_Click"
                          MinWidth="190" Margin="12,0,0,0"/>
                  <TextBlock Text="Ревьюверы Azure" FontSize="16" FontWeight="SemiBold"
                             VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgInfoBrush}" Margin="0,0,0,10"
                           Text="Эти люди будут добавлены в pull request. Обязательные попадут как required. Список сохраняется и больше не спрашивается при каждом Auto PR."/>
                <TextBlock x:Name="AutoReviewersText" Text="Ревьюверы не выбраны" TextWrapping="Wrap"
                           Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="AutoReviewersHost"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Шаблон сообщения Telegram" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,4"
                       Foreground="{StaticResource FgBrush}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,10"
                       Text="Настройте текст, подпись ссылки и получателей. URL PR подставляется автоматически и здесь не редактируется."/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Left" Text="Текст сообщения" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{StaticResource FgBrush}"/>
                      <TextBlock x:Name="TelegramCountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                 Foreground="{StaticResource FgMutedBrush}"/>
                      <Button x:Name="InsertTokenButton" Content="Вставить переменную" Click="OpenTokenMenu_Click"
                              Style="{StaticResource SecondaryButton}"
                              HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{StaticResource FgMutedBrush}"
                               Text="Переменные можно ставить в любое место. {link} — ссылка на PR, {tags} — получатели."/>
                    <TextBox x:Name="TelegramTemplateBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                             VerticalScrollBarVisibility="Auto" TextChanged="AutoTemplate_Changed"/>
                  </DockPanel>
                </Border>

                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Текст ссылки на PR" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBox x:Name="TelegramLinkCaptionBox" Margin="0,8,0,0" TextChanged="AutoTemplate_Changed"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource FgMutedBrush}"
                               Text="Этот текст будет кликабельной ссылкой. Адрес PR приложение подставит само."/>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Получатели" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource FgMutedBrush}"
                               Text="Формат: @username. Несколько имён — через пробел или запятую. Пустой список допустим."/>
                    <WrapPanel x:Name="RecipientHost" Margin="0,0,0,8"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Добавить" Click="AddRecipient_Click" Width="110" Margin="8,0,0,0"/>
                      <TextBox x:Name="RecipientInputBox" ToolTip="@username" KeyDown="RecipientInputBox_KeyDown"/>
                    </DockPanel>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="Свои переменные" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{StaticResource FgMutedBrush}"
                               Text="Дополнительный тег {имя} вставляется в текст. В значении можно оставить {link} — он раскроется один раз."/>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="Добавить" Click="AddCustomTemplate_Click" Width="110" Margin="8,0,0,0"/>
                      <TextBox x:Name="CustomTemplateNameBox" ToolTip="Имя, например note"/>
                    </DockPanel>
                    <StackPanel x:Name="CustomTemplatesHost"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{StaticResource FgBrush}"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
                      <RichTextBox x:Name="TelegramPreviewBox" IsReadOnly="True" IsDocumentEnabled="True"
                                   BorderThickness="0" Background="Transparent"
                                   Foreground="{StaticResource FgBrush}"
                                   CaretBrush="{StaticResource FgBrush}" FontSize="13"
                                   MinHeight="120" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource FgMutedBrush}"
                               Text="Для {text} и адреса PR показаны примеры. Сообщение в Telegram не отправляется."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

<Window x:Class="AutoProdScripts.Views.QuickAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрое добавление"
        Height="680" Width="980"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="110"/>
        <Button Content="Сохранить" Click="Save_Click" Style="{StaticResource SecondaryButton}" Width="120" Margin="8,0,0,0"/>
        <Button Content="Создать PR" Click="CreatePr_Click" Width="130" Margin="8,0,0,0"/>
      </StackPanel>
      <Button Content="Открыть папку mapping" Click="OpenMapping_Click"
              Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Width="190"/>
    </DockPanel>
    <TextBlock x:Name="MappingStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{StaticResource FgMutedBrush}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="+ Скрипт" Click="Add_Click" Width="110"/>
          <Button Content="Удалить" Click="Remove_Click" Style="{StaticResource SecondaryButton}" Width="100" Margin="8,0,0,0"/>
        </StackPanel>
        <ListBox x:Name="ScriptList" DockPanel.Dock="Top" Height="150"
                 DisplayMemberPath="Caption" SelectionChanged="ScriptList_SelectionChanged"/>
        <StackPanel Margin="0,8,0,0">
          <Label Content="Имя файла"/>
          <TextBox x:Name="FileNameBox" TextChanged="FileNameBox_TextChanged" IsEnabled="False"/>
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock Text="USE" Foreground="{StaticResource FgMutedBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox x:Name="UseBox" IsReadOnly="True" Margin="0,4,0,0"/>
          <Label Content="SQL"/>
          <TextBox x:Name="SqlBox" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                   FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                   IsEnabled="False" TextChanged="SqlBox_TextChanged"/>
        </StackPanel>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
      <DockPanel Grid.Column="2" Margin="8,0,0,0">
        <TextBlock DockPanel.Dock="Top" Text="Куда попадут скрипты" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Изменить папку…" Click="ChangeFolder_Click" Style="{StaticResource SecondaryButton}"/>
          <Button Content="Сбросить на mapping" Click="ResetFolder_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
        </StackPanel>
        <TreeView x:Name="TargetTree" SelectedItemChanged="TargetTree_SelectedItemChanged"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

<Window x:Class="AutoProdScripts.Views.FolderPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор папки"
        Width="460"
        Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Выбрать" IsDefault="True" Click="Ok_Click" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <DockPanel>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
               ToolTip="Поиск папки" TextChanged="SearchBox_TextChanged"/>
      <ListBox x:Name="FolderList" DisplayMemberPath="Label"/>
    </DockPanel>
  </DockPanel>
</Window>

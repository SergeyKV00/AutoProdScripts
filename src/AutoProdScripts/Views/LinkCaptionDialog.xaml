<Window x:Class="AutoProdScripts.Views.LinkCaptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текст ссылки"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Ок" IsDefault="True" Click="Ok_Click" Width="100" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel>
      <Label Content="Текст ссылки"/>
      <TextBox x:Name="CaptionBox"/>
      <Label Content="Адрес" Margin="0,8,0,0"/>
      <TextBox x:Name="UrlBox"/>
    </StackPanel>
  </DockPanel>
</Window>

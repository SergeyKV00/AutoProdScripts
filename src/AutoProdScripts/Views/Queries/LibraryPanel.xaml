<UserControl x:Class="AutoProdScripts.Views.Queries.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Без общей подсветки TreeViewItem: она загоралась и на группах-родителях. -->
    <Style TargetType="TreeViewItem">
      <!-- Стандартная тема берёт выравнивание у родительского списка: у узла, созданного в коде,
           его ещё нет — ошибки привязки в выводе. Значения те же, что у TreeView по умолчанию. -->
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
      <Setter Property="Padding" Value="1"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource OnSelectionBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LibraryRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <DockPanel Background="{DynamicResource PanelBrush}">
    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Content="＋ Цепочка" Click="NewChain_Click" Margin="0"
                Style="{StaticResource SecondaryButton}" ToolTip="Новая цепочка скриптов"/>
        <TextBlock Text="БИБЛИОТЕКА" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource FgBrush}"/>
      </DockPanel>
      <UniformGrid Columns="2" Margin="0,0,0,8">
        <Button Content="Импорт…" Click="Import_Click" Margin="0,0,3,0" Style="{StaticResource SecondaryButton}"
                ToolTip="Загрузить скрипты и цепочки из файла"/>
        <Button Content="Экспорт всего…" Click="ExportAll_Click" Margin="3,0,0,0" Style="{StaticResource SecondaryButton}"
                ToolTip="Вся библиотека в один файл"/>
      </UniformGrid>
      <TextBlock Text="Поиск" Margin="0,0,0,4" TextWrapping="Wrap"
                 Foreground="{DynamicResource FgMutedBrush}"/>
      <TextBox x:Name="SearchBox" TextChanged="Filter_Changed"/>
      <ComboBox x:Name="ViewBox" Margin="0,6,0,0" SelectionChanged="Filter_Changed"/>
      <ComboBox x:Name="ConnectionFilter" Margin="0,6,0,0" SelectionChanged="Filter_Changed"/>
      <ComboBox x:Name="TagFilter" Margin="0,6,0,0" SelectionChanged="Filter_Changed"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Margin="8,4" TextWrapping="Wrap" MaxHeight="80"
               Visibility="Collapsed" Foreground="{DynamicResource WarnBrush}"/>
    <Grid>
      <TreeView x:Name="Tree" Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                PreviewKeyDown="Tree_PreviewKeyDown"
                PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                ContextMenuOpening="Tree_ContextMenuOpening">
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="OpenMenu" Header="Открыть" Click="Open_Click"/>
            <MenuItem x:Name="PropertiesMenu" Header="Свойства…" Click="Properties_Click"/>
            <MenuItem x:Name="FavoriteItem" Header="В избранное" Click="Favorite_Click"/>
            <MenuItem x:Name="DuplicateMenu" Header="Дублировать" Click="Duplicate_Click"/>
            <MenuItem x:Name="ExportMenu" Header="Экспортировать…" Click="Export_Click"/>
            <MenuItem x:Name="ExportGroupMenu" Header="Экспортировать группу…" Click="ExportGroup_Click"/>
            <Separator x:Name="DeleteSeparator"/>
            <MenuItem x:Name="DeleteMenu" Header="Удалить" Click="Delete_Click"/>
          </ContextMenu>
        </TreeView.ContextMenu>
      </TreeView>
      <!-- Лежит поверх дерева: без IsHitTestVisible="False" даже пустая надпись перехватывала бы мышь. -->
      <TextBlock x:Name="EmptyText" Margin="8" TextWrapping="Wrap" VerticalAlignment="Top" IsHitTestVisible="False"
                 Foreground="{DynamicResource FgMutedBrush}"/>
    </Grid>
  </DockPanel>
</UserControl>

<Window x:Class="AutoProdScripts.Views.Queries.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:queries="clr-namespace:AutoProdScripts.Views.Queries"
        Title="Подключения и регионы"
        Height="760" Width="940"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing">
  <TabControl Margin="16">
    <TabItem Header="Подключения">
      <queries:ConnectionsEditor x:Name="Editor"/>
    </TabItem>
    <TabItem Header="Регионы">
      <queries:RegionsEditor x:Name="RegionList"/>
    </TabItem>
  </TabControl>
</Window>

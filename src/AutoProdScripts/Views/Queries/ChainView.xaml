<UserControl x:Class="AutoProdScripts.Views.Queries.ChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:queries="clr-namespace:AutoProdScripts.Views.Queries"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
  <DockPanel Background="{DynamicResource BgBrush}">
    <Border x:Name="Header" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,6"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RunButton" Content="▶ Выполнить (F5)" Click="Run_Click"/>
          <Button x:Name="CancelButton" Content="■ Отмена" Click="Cancel_Click" IsEnabled="False"
                  Style="{StaticResource SecondaryButton}"/>
          <TextBlock Text="Лимит строк" VerticalAlignment="Center" Margin="12,0,6,0"
                     Foreground="{DynamicResource FgMutedBrush}"/>
          <TextBox x:Name="MaxRowsBox" Width="70" Text="10000" VerticalAlignment="Center"/>
          <Button x:Name="SaveButton" Content="Сохранить" Click="Save_Click" ToolTip="Ctrl+S" Margin="12,0,0,0"/>
          <Button x:Name="NewScriptButton" Content="Новый скрипт" Click="NewScript_Click"
                  Style="{StaticResource ToolbarButton}"/>
        </StackPanel>
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource FgBrush}"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="8,4">
      <TextBlock x:Name="ProblemsText" TextWrapping="Wrap" MaxHeight="60"/>
    </Border>

    <TabControl x:Name="Tabs">
      <TabItem x:Name="RunTab" Header="Запуск">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Background="{DynamicResource PanelBrush}">
            <DockPanel DockPanel.Dock="Top" Margin="8,6,8,0">
              <Button DockPanel.Dock="Right" Content="Очистить" Click="ClearParameters_Click" Margin="0"
                      Style="{StaticResource ToolbarButton}" ToolTip="Очистить введённые значения"/>
              <TextBlock Text="ОБЩИЕ ПАРАМЕТРЫ" FontWeight="SemiBold" VerticalAlignment="Center"
                         Foreground="{DynamicResource FgBrush}"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Enter или F5 — выполнить" Margin="8,4"
                       Foreground="{DynamicResource FgMutedBrush}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="RunParameters" Margin="8,0,8,8"/>
            </ScrollViewer>
          </DockPanel>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                        ResizeDirection="Columns" Background="{DynamicResource BorderBrush}"/>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="StepStatuses" Margin="8,6"/>
            </ScrollViewer>
            <queries:ResultsPanel x:Name="Results" Grid.Row="1"/>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem x:Name="EditTab" Header="Шаги и свойства">
        <Grid x:Name="EditRoot">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" MinWidth="380"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
          </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Label Content="Название цепочки"/>
            <TextBox x:Name="NameBox" TextChanged="Property_Changed"/>
            <Label Content="Группа (вложенность через /)"/>
            <ComboBox x:Name="GroupBox" IsEditable="True" LostFocus="Property_LostFocus"/>
            <Label Content="Теги через запятую"/>
            <TextBox x:Name="TagsBox" TextChanged="Property_Changed"/>
            <Label Content="Описание: когда использовать, что означают результаты"/>
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                     VerticalScrollBarVisibility="Auto" TextChanged="Property_Changed"/>

            <TextBlock Text="Шаги" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,6"
                       Foreground="{DynamicResource FgBrush}"/>
            <StackPanel x:Name="StepsHost"/>
            <Button Content="＋ Добавить шаг" Click="AddStep_Click" HorizontalAlignment="Left" Margin="0"/>

            <TextBlock Text="Общие параметры" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,4"
                       Foreground="{DynamicResource FgBrush}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource FgMutedBrush}"
                       Text="Вводятся один раз и передаются во все шаги. Значение по умолчанию хранится в файле — не записывайте туда персональные данные и пароли. Если у параметра в самом скрипте задан тип, используется он."/>
            <StackPanel x:Name="CommonHost"/>
          </StackPanel>
        </ScrollViewer>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                        ResizeDirection="Columns" Background="{DynamicResource BorderBrush}"/>
          <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock x:Name="StepTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource FgBrush}"/>
                <TextBox x:Name="StepNameBox" Margin="0,6,0,0" TextChanged="StepName_Changed"
                         ToolTip="Название скрипта шага"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="ToLibraryButton" Content="Сохранить в библиотеку…" Click="ToLibrary_Click" Margin="0,0,8,0"/>
                  <Button x:Name="UpdateLibraryButton" Content="Обновить в библиотеке" Click="UpdateLibrary_Click" Margin="0,0,8,0"/>
                  <Button x:Name="KeepInChainButton" Content="Сделать копию в цепочке" Click="KeepInChain_Click"
                          Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                  <Button x:Name="RevertButton" Content="Отменить правки" Click="Revert_Click"
                          Style="{StaticResource SecondaryButton}" Margin="0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" Padding="8,4">
              <TextBlock x:Name="StepCheck" TextWrapping="Wrap" MaxHeight="60"/>
            </Border>
            <avalonEdit:TextEditor x:Name="StepEditor"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True" WordWrap="False"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                   Background="{DynamicResource GlassBgBrush}"
                                   Foreground="{DynamicResource FgBrush}"
                                   LineNumbersForeground="{DynamicResource LineNumbersBrush}"/>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

<Window x:Class="AutoProdScripts.Views.Queries.ImportConnectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление подключений"
        Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Добавить отмеченные" Click="Add_Click" IsDefault="True" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ErrorsText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource WarnBrush}"/>
    <TextBlock DockPanel.Dock="Top" Text="Найдено несколько строк. Отметьте, какие добавить."
               Margin="0,0,0,8" Foreground="{DynamicResource FgBrush}"/>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Host" Margin="8"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>

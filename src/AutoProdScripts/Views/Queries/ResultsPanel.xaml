<UserControl x:Class="AutoProdScripts.Views.Queries.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Background="{DynamicResource PanelBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="8,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" IsEnabled="False"
                Style="{StaticResource SecondaryButton}"
                ToolTip="Выделенные ячейки или весь набор, с заголовками"/>
        <Button x:Name="ExportButton" Content="Экспорт в CSV…" Click="Export_Click" IsEnabled="False"
                Style="{StaticResource SecondaryButton}"/>
      </StackPanel>
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource FgMutedBrush}"/>
    </DockPanel>
    <TabControl x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
      <TabItem x:Name="MessagesTab" Header="Сообщения">
        <TextBox x:Name="MessagesBox" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource BgBrush}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

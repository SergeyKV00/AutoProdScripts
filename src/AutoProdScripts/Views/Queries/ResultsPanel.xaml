<UserControl x:Class="AutoProdScripts.Views.Queries.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Заголовок группы — плашка во всю ширину таблицы. -->
    <Style x:Key="RegionGroup" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel>
              <Border Background="{DynamicResource GroupRowBrush}" BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="4,0,0,0" Padding="10,5" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource FgBrush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}  ·  строк: {1}">
                      <Binding Path="Name"/>
                      <Binding Path="ItemCount"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <ItemsPresenter/>
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel Background="{DynamicResource PanelBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="8,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CopyButton" Content="Копировать" Click="Copy_Click" IsEnabled="False"
                Style="{StaticResource SecondaryButton}"
                ToolTip="Выделенные ячейки или весь набор, с заголовками"/>
        <Button x:Name="ExportButton" Content="Экспорт в CSV…" Click="Export_Click" IsEnabled="False"
                Style="{StaticResource SecondaryButton}"/>
      </StackPanel>
      <CheckBox x:Name="GroupBox" DockPanel.Dock="Right" Content="Группировать по регионам" Margin="12,0,12,0"
                VerticalAlignment="Center" Visibility="Collapsed" Click="Group_Click"/>
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource FgMutedBrush}"/>
    </DockPanel>
    <TabControl x:Name="ResultTabs" SelectionChanged="ResultTabs_SelectionChanged">
      <TabItem x:Name="MessagesTab" Header="Сообщения">
        <TextBox x:Name="MessagesBox" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource BgBrush}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

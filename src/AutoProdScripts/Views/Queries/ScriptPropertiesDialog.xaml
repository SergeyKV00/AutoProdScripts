<Window x:Class="AutoProdScripts.Views.Queries.ScriptPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свойства скрипта"
        Height="700" Width="720"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Сохранить" Click="Save_Click" IsDefault="True" Width="140" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource DangerBrush}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <Label Content="Название"/>
        <TextBox x:Name="NameBox"/>
        <Label Content="Группа (вложенность через /)"/>
        <ComboBox x:Name="GroupBox" IsEditable="True"/>
        <Label Content="Теги через запятую"/>
        <TextBox x:Name="TagsBox"/>
        <Label Content="Описание"/>
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                 VerticalScrollBarVisibility="Auto"/>
        <Label Content="Подключение"/>
        <ComboBox x:Name="ConnectionBox" SelectionChanged="Connection_Changed"/>
        <StackPanel x:Name="RegionPanel" Visibility="Collapsed">
          <Label Content="База (KMIS → KMIS_ast)"/>
          <TextBox x:Name="RegionTemplateBox"/>
        </StackPanel>

        <TextBlock Text="Параметры" FontWeight="SemiBold" Margin="0,16,0,4" Foreground="{DynamicResource FgBrush}"/>
        <TextBlock x:Name="ParametersHint" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource FgMutedBrush}"/>
        <StackPanel x:Name="ParametersHost"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

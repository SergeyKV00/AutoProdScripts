<UserControl x:Class="AutoProdScripts.Views.Queries.ConnectionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <Button Content="Добавить" Click="Add_Click" Margin="0,0,0,6"/>
        <Button x:Name="DuplicateButton" Content="Дублировать" Click="Duplicate_Click"
                Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"/>
        <Button x:Name="DeleteButton" Content="Удалить" Click="Delete_Click"
                Style="{StaticResource SecondaryButton}" Margin="0"/>
      </StackPanel>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ListBox x:Name="List" SelectionChanged="List_SelectionChanged"/>
      </Border>
    </DockPanel>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
          <StackPanel>
            <TextBlock Text="Вставить строку подключения" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource FgMutedBrush}"
                       Text="Вставьте строку или блок из конфига (Ctrl+V) — поля заполнятся сами. Вставленный текст с паролем в поле не остаётся."/>
            <TextBox x:Name="PasteBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Вставить из буфера" Click="PasteFromClipboard_Click" Margin="0"/>
              <Button Content="Разобрать набранное" Click="ParseTyped_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Label Content="Имя"/>
        <TextBox x:Name="NameBox"/>

        <Label Content="Среда"/>
        <ComboBox x:Name="EnvironmentBox"/>

        <Label Content="Сервер или listener кластера"/>
        <TextBox x:Name="ServerBox"/>

        <Label Content="База"/>
        <TextBox x:Name="DatabaseBox"/>

        <Label Content="Вход"/>
        <ComboBox x:Name="AuthBox" SelectionChanged="Auth_SelectionChanged"/>

        <StackPanel x:Name="SqlLoginPanel">
          <Label Content="Логин"/>
          <TextBox x:Name="UserBox"/>
          <Label Content="Пароль"/>
          <PasswordBox x:Name="PasswordInput"/>
          <TextBlock x:Name="PasswordHint" Foreground="{DynamicResource FgMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <CheckBox x:Name="EncryptBox" Content="Шифровать соединение (Encrypt)" Margin="0,12,0,0"/>
        <CheckBox x:Name="TrustBox" Content="Доверять сертификату сервера (TrustServerCertificate)" Margin="0,6,0,0"/>
        <CheckBox x:Name="ReadOnlyIntentBox" Content="Читать с реплики (ApplicationIntent=ReadOnly)" Margin="0,6,0,0"/>

        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Label Content="Таймаут подключения, с"/>
            <TextBox x:Name="ConnectTimeoutBox"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Таймаут запроса, с"/>
            <TextBox x:Name="CommandTimeoutBox"/>
          </StackPanel>
        </Grid>

        <Label Content="Прочие параметры строки подключения"/>
        <TextBox x:Name="ExtraBox" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="SaveButton" Content="Сохранить подключение" Click="SaveConnection_Click" Margin="0"/>
          <Button x:Name="TestButton" Content="Проверить подключение" Click="Test_Click"
                  Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource FgInfoBrush}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<Window x:Class="AutoProdScripts.Views.NewBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая ветка"
        Height="260" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        ResizeMode="NoResize">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Создать от base + checkout" Click="Create_Click" Width="200" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel>
      <Label Content="Базовая ветка"/>
      <ComboBox x:Name="BaseBranchBox" IsEditable="True"/>
      <Label Content="Имя новой ветки" Margin="0,12,0,0"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Авто" Click="AutoName_Click" Width="70" Margin="8,0,0,0"
                ToolTip="baseBranch_yyyyMMddHHmm"/>
        <TextBox x:Name="BranchNameBox"/>
      </DockPanel>
      <TextBlock Text="Авто: {baseBranch}_{yyyyMMddHHmm}" Foreground="{StaticResource FgMutedBrush}" Margin="0,6,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>

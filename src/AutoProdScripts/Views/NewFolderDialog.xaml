<Window x:Class="AutoProdScripts.Views.NewFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая папка"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="100"/>
      <Button Content="Создать" IsDefault="True" Click="Ok_Click" Width="110" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="FolderText" TextWrapping="Wrap" Foreground="{StaticResource FgMutedBrush}" Margin="0,0,0,8"/>
      <Label Content="Имя папки"/>
      <TextBox x:Name="NameBox"/>
    </StackPanel>
  </DockPanel>
</Window>

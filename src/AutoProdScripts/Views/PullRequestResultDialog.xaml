<Window x:Class="AutoProdScripts.Views.PullRequestResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pull Request"
        Height="320" Width="560"
        MinHeight="280" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CopyMessageButton" Content="Копировать сообщение" Click="CopyMessage_Click"
              Width="180" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
      <Button x:Name="OpenButton" Content="Открыть в браузере" Click="Open_Click" Width="160"/>
      <Button Content="Копировать ссылку" Click="Copy_Click" Width="140" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"/>
      <Button Content="Закрыть" Click="Close_Click" Width="100" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource FgBrush}"/>
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource FgBrush}"/>
        <Label Content="Ссылка:" Margin="0,16,0,0"/>
        <TextBox x:Name="UrlBox" IsReadOnly="True" TextWrapping="Wrap" Height="52"/>

        <StackPanel x:Name="TelegramPanel" Visibility="Collapsed" Margin="0,16,0,0">
          <TextBlock Text="Сообщение для Telegram" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
          <RichTextBox x:Name="TelegramMessageBox" Margin="0,8,0,0" Height="140"
                       IsDocumentEnabled="True"
                       Background="{DynamicResource InputBrush}"
                       Foreground="{DynamicResource FgBrush}"
                       CaretBrush="{DynamicResource FgBrush}"
                       BorderBrush="{DynamicResource BorderBrush}"
                       DataObject.Copying="TelegramMessageBox_Copying"/>
          <TextBlock Text="Ctrl+K — изменить выделенную ссылку в тексте" Foreground="{DynamicResource FgMutedBrush}" Margin="0,4,0,0"/>

          <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Очистить список" Click="ClearManagedLinks_Click"
                        Style="{StaticResource SecondaryButton}" Width="140" Margin="8,0,0,0"/>
                <TextBlock Text="Список ссылок" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgBrush}"/>
              </DockPanel>
              <StackPanel x:Name="ManagedLinksHost"/>
              <TextBlock x:Name="ManagedLinksEmptyText" TextWrapping="Wrap" Margin="0,0,0,8"
                         Foreground="{DynamicResource FgMutedBrush}"
                         Text="Список пуст. Вставьте или введите ссылки ниже."/>
              <DockPanel>
                <!--<Button DockPanel.Dock="Right" Content="Добавить" Click="AddManagedLinks_Click" Width="110" Margin="8,0,0,0"/>-->
                <TextBox x:Name="LinkPasteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="LinkPasteBox_PreviewKeyDown"
                         DataObject.Pasting="LinkPasteBox_Pasting"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

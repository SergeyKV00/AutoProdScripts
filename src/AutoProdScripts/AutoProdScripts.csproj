<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Allow restore/packaging metadata on non-Windows CI; runtime build requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon />
    <AssemblyName>AutoProdScripts</AssemblyName>
    <RootNamespace>AutoProdScripts</RootNamespace>
    <Product>AutoProdScripts</Product>
    <Description>IDE-подобное приложение для работы с продакшн SQL-скриптами и PR в Azure DevOps</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>

<Window x:Class="AutoProdScripts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="AutoProdScripts"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Файл">
        <MenuItem Header="Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Настройки…" Click="Settings_Click"/>
        <Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="Правка">
        <MenuItem Header="Найти…" IsEnabled="False"/>
      </MenuItem>
      <MenuItem Header="Git">
        <MenuItem Header="Sync" Click="Sync_Click"/>
        <MenuItem Header="Новая ветка…" Click="NewBranch_Click"/>
        <MenuItem Header="Переключить ветку…" Click="SwitchBranch_Click"/>
        <MenuItem Header="Статус" Click="Status_Click"/>
      </MenuItem>
      <MenuItem Header="PR">
        <MenuItem Header="Create PR…" Click="CreatePr_Click"/>
        <MenuItem Header="Auto Pull Request" Click="AutoPr_Click"/>
      </MenuItem>
      <MenuItem Header="Войти…" Click="SignIn_Click"/>
      <MenuItem Header="Настройки" Click="Settings_Click"/>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBrush}">
      <ToolBar>
        <Button Content="↻ Sync" Click="Sync_Click" ToolTip="Подтянуть файлы текущей ветки"/>
        <Button Content="⎇ Новая ветка" Click="NewBranch_Click"/>
        <Button Content="📄 Новый скрипт" Click="NewScript_Click"/>
        <Separator/>
        <Button Content="💾 Сохранить" Click="Save_Click"/>
        <Button Content="↗ Create PR" Click="CreatePr_Click"/>
        <Separator/>
        <Button Content="Войти" Click="SignIn_Click" ToolTip="Вход в Azure DevOps через учётную запись Microsoft"/>
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" Height="28">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="готов" Foreground="White"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="BranchStatusText" Text="ветка: —" Foreground="White"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="AuthStatusText" Text="вход: —" Foreground="White"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="UTF-8" Foreground="White"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="280" MinWidth="200"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="140" MinHeight="72"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource BgBrush}">
          <Border DockPanel.Dock="Top"
                  MinHeight="32"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock x:Name="EmptyTabsText"
                         Text="нет открытых файлов"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalAlignment="Stretch">
                <StackPanel x:Name="FileTabStrip" Orientation="Horizontal"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <avalonEdit:TextEditor x:Name="SqlEditor"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 ShowLineNumbers="True"
                                 WordWrap="False"
                                 Background="{StaticResource BgBrush}"
                                 Foreground="{StaticResource FgBrush}"
                                 LineNumbersForeground="#858585"/>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Row="2" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="Лог" FontWeight="SemiBold" Margin="8,6,8,2"
                     Foreground="{StaticResource FgBrush}"/>
          <TextBox x:Name="LogBox"
                   IsReadOnly="True"
                   IsReadOnlyCaretVisible="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   BorderThickness="0"
                   Background="{StaticResource BgBrush}"
                   Foreground="{StaticResource FgBrush}"
                   CaretBrush="{StaticResource FgBrush}"
                   FontFamily="Consolas"
                   FontSize="12"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource BorderBrush}"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="240" MinHeight="140"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="ПРОЕКТ" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{StaticResource FgBrush}"/>
          <TreeView x:Name="ProjectTree"
                    Padding="2,2,0,4"
                    MouseDoubleClick="ProjectTree_MouseDoubleClick"
                    PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                    PreviewKeyDown="ProjectTree_PreviewKeyDown"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="8,8,8,4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <Button x:Name="AutoPrButton" Content="Auto Pull Request" Click="AutoPr_Click"
                  HorizontalAlignment="Stretch"
                  ToolTip="Создать ветку, закоммитить скрипты и открыть PR по шаблону"/>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Row="3" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="ВЕТКА / PR" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{StaticResource FgBrush}"/>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
            <TextBlock Text="Ветка" Foreground="{StaticResource FgMutedBrush}"/>
            <Grid Margin="0,4,0,0">
              <ToggleButton x:Name="BranchButton"
                            Style="{StaticResource BranchPickerButton}"
                            IsChecked="{Binding IsOpen, ElementName=BranchPopup, Mode=TwoWay}"
                            ToolTip="Переключить текущую ветку">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="▾" Margin="8,0,0,0"
                             VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}"/>
                  <TextBlock x:Name="BranchButtonText" Text="—" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                </DockPanel>
              </ToggleButton>
              <Popup x:Name="BranchPopup"
                     PlacementTarget="{Binding ElementName=BranchButton}"
                     Placement="Bottom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     PopupAnimation="Fade"
                     Opened="BranchPopup_Opened">
                <Border Background="{StaticResource PanelAltBrush}"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        Padding="8"
                        MinWidth="{Binding ActualWidth, ElementName=BranchButton}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Поиск" Margin="0,0,0,4"
                               Foreground="{StaticResource FgMutedBrush}"/>
                    <TextBox x:Name="BranchSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             TextChanged="BranchSearchBox_TextChanged"/>
                    <TextBlock x:Name="BranchEmptyText" DockPanel.Dock="Top" Text="нет веток"
                               Margin="0,4" Visibility="Collapsed"
                               Foreground="{StaticResource FgMutedBrush}"/>
                    <TreeView x:Name="BranchTree"
                              MaxHeight="320"
                              BorderThickness="0"
                              Background="{StaticResource PanelAltBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItemChanged="BranchTree_SelectedItemChanged"/>
                  </DockPanel>
                </Border>
              </Popup>
            </Grid>
            <TextBlock x:Name="SideBaseText" Text="от: —" Margin="0,4,0,0"
                       Foreground="{StaticResource FgMutedBrush}"/>
            <Button Content="Create PR" Click="CreatePr_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Изменения:" Margin="8,0,8,4"
                     Foreground="{StaticResource FgMutedBrush}"/>
          <Grid>
            <TextBlock x:Name="NoChangesText"
                       Text="нет изменений"
                       Margin="8,4"
                       Foreground="{StaticResource FgMutedBrush}"/>
            <TreeView x:Name="ChangesTree"
                      Padding="2,2,0,4"
                      MouseDoubleClick="ChangesTree_MouseDoubleClick"
                      PreviewMouseRightButtonDown="ChangesTree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="ChangesTree_ContextMenuOpening">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Отменить изменения" Click="RevertChange_Click"/>
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
          </Grid>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

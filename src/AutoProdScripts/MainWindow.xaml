<Window x:Class="AutoProdScripts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="AutoProdScripts"
        Height="720" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Файл">
        <MenuItem Header="Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Быстрое добавление…" Click="QuickAdd_Click"/>
        <MenuItem Header="Проанализировать папки и USE" Click="AnalyzeUse_Click"/>
        <MenuItem Header="Обновить mapping" Click="ReloadMapping_Click"/>
        <MenuItem Header="Открыть папку mapping" Click="OpenMappingFolder_Click"/>
        <MenuItem Header="Настройки…" Click="Settings_Click"/>
        <Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="Git">
        <MenuItem Header="Sync" Click="Sync_Click"/>
        <MenuItem Header="Новая ветка…" Click="NewBranch_Click"/>
        <MenuItem Header="Переключить ветку…" Click="SwitchBranch_Click"/>
        <MenuItem Header="Статус" Click="Status_Click"/>
      </MenuItem>
      <MenuItem Header="PR">
        <MenuItem Header="Create PR…" Click="CreatePr_Click"/>
        <MenuItem Header="Auto Pull Request" Click="AutoPr_Click"/>
      </MenuItem>
      <MenuItem Header="Настройки" Click="Settings_Click"/>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Файлы" VerticalAlignment="Center" Margin="4,0,6,0"
                   Foreground="{StaticResource FgMutedBrush}"/>
        <Button Content="📄 Новый скрипт" Click="NewScript_Click" Style="{StaticResource ToolbarButton}"/>
        <Button Content="💾 Сохранить" Click="Save_Click" Style="{StaticResource ToolbarButton}"/>
        <Border Width="1" Margin="12,2" Background="{StaticResource BorderBrush}"/>
        <TextBlock Text="Git" VerticalAlignment="Center" Margin="4,0,6,0"
                   Foreground="{StaticResource FgMutedBrush}"/>
        <Button Content="↻ Sync" Click="Sync_Click" Style="{StaticResource ToolbarButton}"
                ToolTip="Подтянуть файлы текущей ветки"/>
        <Button Content="⎇ Новая ветка" Click="NewBranch_Click" Style="{StaticResource ToolbarButton}"/>
      </StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Height="32">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal" Margin="4,0,8,0">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
            <Ellipse.Fill>
              <SolidColorBrush Color="#3DDC97"/>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock x:Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
            <TextBlock.Foreground>
              <SolidColorBrush Color="#3DDC97"/>
            </TextBlock.Foreground>
          </TextBlock>
        </StackPanel>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="BranchStatusText" Text="ветка: —" Foreground="White"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="AuthStatusText" Text="вход: —" Foreground="White"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="UTF-8" Foreground="White"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="280" MinWidth="200"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="140" MinHeight="72"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource BgBrush}">
          <Border DockPanel.Dock="Top"
                  MinHeight="32"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock x:Name="EmptyTabsText"
                         Text="нет открытых файлов"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FgMutedBrush}"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalAlignment="Stretch">
                <StackPanel x:Name="FileTabStrip" Orientation="Horizontal"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <avalonEdit:TextEditor x:Name="SqlEditor"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 ShowLineNumbers="True"
                                 WordWrap="False"
                                 Background="{StaticResource BgBrush}"
                                 Foreground="{StaticResource FgBrush}"
                                 LineNumbersForeground="#7E90A8"/>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Row="2" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="Лог" FontWeight="SemiBold" Margin="8,6,8,2"
                     Foreground="{StaticResource FgBrush}"/>
          <RichTextBox x:Name="LogBox"
                       IsReadOnly="True"
                       IsDocumentEnabled="False"
                       BorderThickness="0"
                       Background="{StaticResource BgBrush}"
                       Foreground="{StaticResource FgBrush}"
                       CaretBrush="{StaticResource FgBrush}"
                       FontFamily="Consolas"
                       FontSize="12"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource BorderBrush}"/>

      <Grid x:Name="RightColumn" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="80"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="360" MinHeight="220"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="ПРОЕКТ" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{StaticResource FgBrush}"/>
          <TreeView x:Name="ProjectTree"
                    Padding="2,2,0,4"
                    MouseDoubleClick="ProjectTree_MouseDoubleClick"
                    PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                    PreviewKeyDown="ProjectTree_PreviewKeyDown">
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Создать файл" Click="CreateFileFromTree_Click"/>
                <MenuItem Header="Создать папку" Click="CreateFolderFromTree_Click"/>
                <Separator/>
                <MenuItem Header="Удалить" Click="DeleteFromTree_Click"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Row="2" Background="{StaticResource PanelBrush}">
          <Border DockPanel.Dock="Top" Padding="8,8,8,0">
            <Button Click="QuickAdd_Click"
                    Style="{StaticResource QuickAddButton}"
                    HorizontalAlignment="Stretch"
                    ToolTip="Вставить несколько SQL и разложить по папкам">
              <TextBlock Text="⚡ Быстрое добавление" VerticalAlignment="Center"/>
            </Button>
          </Border>
          <Border DockPanel.Dock="Top" Padding="8,8,8,8"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Button x:Name="AutoPrButton" Click="AutoPr_Click"
                    Height="36" Margin="0" Padding="10,4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    ToolTip="Создать ветку, закоммитить скрипты и открыть PR по шаблону">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Width="11" Height="11" Stretch="Uniform" Fill="White" VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <Path Width="6" Height="6" Stretch="Uniform" Fill="#D6E6FF" Margin="3,0,0,7"
                      VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <TextBlock Text="Auto Pull Request" Margin="8,0" VerticalAlignment="Center"/>
                <Path Width="6" Height="6" Stretch="Uniform" Fill="#D6E6FF" Margin="0,7,3,0"
                      VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <Path Width="11" Height="11" Stretch="Uniform" Fill="White" VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
              </StackPanel>
            </Button>
          </Border>
          <TextBlock DockPanel.Dock="Top" Text="ВЕТКА / PR" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{StaticResource FgBrush}"/>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
            <TextBlock Text="Ветка" Foreground="{StaticResource FgMutedBrush}"/>
            <Grid Margin="0,4,0,0">
              <ToggleButton x:Name="BranchButton"
                            Style="{StaticResource BranchPickerButton}"
                            IsChecked="{Binding IsOpen, ElementName=BranchPopup, Mode=TwoWay}"
                            ToolTip="Переключить текущую ветку">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="▴" Margin="8,0,0,0"
                             VerticalAlignment="Center" Foreground="{StaticResource FgMutedBrush}"/>
                  <TextBlock x:Name="BranchButtonText" Text="—" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                </DockPanel>
              </ToggleButton>
              <Popup x:Name="BranchPopup"
                     PlacementTarget="{Binding ElementName=BranchButton}"
                     Placement="Custom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     PopupAnimation="None"
                     Opened="BranchPopup_Opened">
                <Border Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8"
                        MinWidth="{Binding ActualWidth, ElementName=BranchButton}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Поиск" Margin="0,0,0,4"
                               Foreground="{StaticResource FgMutedBrush}"/>
                    <TextBox x:Name="BranchSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             TextChanged="BranchSearchBox_TextChanged"/>
                    <Grid Height="260">
                      <TreeView x:Name="BranchTree"
                                BorderThickness="0"
                                Background="{StaticResource PanelAltBrush}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                SelectedItemChanged="BranchTree_SelectedItemChanged"/>
                      <TextBlock x:Name="BranchEmptyText" Text="нет веток"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Foreground="{StaticResource FgMutedBrush}"/>
                    </Grid>
                  </DockPanel>
                </Border>
              </Popup>
            </Grid>
            <TextBlock x:Name="SideBaseText" Text="от: —" Margin="0,4,0,0"
                       Foreground="{StaticResource FgMutedBrush}"/>
            <Button Content="Create PR" Click="CreatePr_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Изменения:" Margin="8,0,8,4"
                     Foreground="{StaticResource FgMutedBrush}"/>
          <Grid>
            <TextBlock x:Name="NoChangesText"
                       Text="нет изменений"
                       Margin="8,4"
                       Foreground="{StaticResource FgMutedBrush}"/>
            <TreeView x:Name="ChangesTree"
                      Padding="2,2,0,4"
                      MouseDoubleClick="ChangesTree_MouseDoubleClick"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>

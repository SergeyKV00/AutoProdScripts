<Window x:Class="AutoProdScripts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="AutoProdScripts"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Foreground="{StaticResource FgBrush}">
      <MenuItem Header="Файл">
        <MenuItem Header="Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Настройки…" Click="Settings_Click"/>
        <Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="Правка">
        <MenuItem Header="Найти…" IsEnabled="False"/>
      </MenuItem>
      <MenuItem Header="Git">
        <MenuItem Header="Sync (fetch)" Click="Sync_Click"/>
        <MenuItem Header="Новая ветка…" Click="NewBranch_Click"/>
        <MenuItem Header="Статус" Click="Status_Click"/>
      </MenuItem>
      <MenuItem Header="PR">
        <MenuItem Header="Create PR…" Click="CreatePr_Click"/>
      </MenuItem>
      <MenuItem Header="Настройки" Click="Settings_Click"/>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBrush}">
      <ToolBar Background="{StaticResource PanelBrush}" Foreground="{StaticResource FgBrush}">
        <Button Content="↻ Sync" Click="Sync_Click" ToolTip="git fetch"/>
        <Button Content="⎇ Новая ветка" Click="NewBranch_Click"/>
        <Button Content="📄 Новый скрипт" Click="NewScript_Click"/>
        <Separator/>
        <Button Content="💾 Сохранить" Click="Save_Click"/>
        <Button Content="↗ Create PR" Click="CreatePr_Click"/>
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource StatusBrush}" Foreground="White" Height="28">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="готов"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="BranchStatusText" Text="ветка: —"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="UTF-8"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="140"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="160"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*" MinWidth="300"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="240" MinWidth="180"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="ПРОЕКТ" FontWeight="SemiBold" Margin="8,8,8,4"/>
          <TreeView x:Name="ProjectTree"
                    Background="{StaticResource PanelBrush}"
                    Foreground="{StaticResource FgBrush}"
                    BorderThickness="0"
                    MouseDoubleClick="ProjectTree_MouseDoubleClick"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Column="2">
          <TextBlock x:Name="EditorPathText" DockPanel.Dock="Top"
                     Text="(файл не выбран)" Margin="8,6" Foreground="#9CDCFE"/>
          <avalonEdit:TextEditor x:Name="SqlEditor"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 ShowLineNumbers="True"
                                 WordWrap="False"
                                 Background="#1E1E1E"
                                 Foreground="#D4D4D4"
                                 LineNumbersForeground="#858585"/>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

        <DockPanel Grid.Column="4" Background="{StaticResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="ВЕТКА / PR" FontWeight="SemiBold" Margin="8,8,8,4"/>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
            <TextBlock x:Name="SideBranchText" Text="Ветка: —" TextWrapping="Wrap"/>
            <TextBlock x:Name="SideBaseText" Text="от: —" Margin="0,4,0,0" Foreground="#888888"/>
            <Button Content="Create PR" Click="CreatePr_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Изменения:" Margin="8,0,8,4" Foreground="#888888"/>
          <ListBox x:Name="ChangesList"
                   Background="{StaticResource PanelBrush}"
                   Foreground="{StaticResource FgBrush}"
                   BorderThickness="0"/>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

      <DockPanel Grid.Row="2" Background="{StaticResource PanelBrush}">
        <TextBlock DockPanel.Dock="Top" Text="Лог" FontWeight="SemiBold" Margin="8,6,8,2"/>
        <ListBox x:Name="LogList"
                 Background="#1E1E1E"
                 Foreground="#CCCCCC"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="12"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>

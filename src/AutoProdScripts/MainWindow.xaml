<Window x:Class="AutoProdScripts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:queries="clr-namespace:AutoProdScripts.Views.Queries"
        Title="{DynamicResource AppTitle}"
        Height="720" Width="1200"
        WindowState="Maximized"
        BorderThickness="0"
        Tag="NoNeon"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">
  <DockPanel>
    <!-- Меню зависит от раздела: в «Запросах» нет git и PR. -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="Файл">
        <MenuItem x:Name="RepoSaveItem" Header="Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
        <MenuItem x:Name="RepoQuickAddItem" Header="Быстрое добавление…" Click="QuickAdd_Click"/>
        <MenuItem x:Name="RepoMappingItem" Header="Открыть папку mapping" Click="OpenMappingFolder_Click"/>
        <MenuItem x:Name="QueriesNewItem" Header="Новый скрипт" Click="QueriesNew_Click" InputGestureText="Ctrl+N"
                  Visibility="Collapsed"/>
        <MenuItem x:Name="QueriesOpenItem" Header="Открыть файл…" Click="QueriesOpen_Click" InputGestureText="Ctrl+O"
                  Visibility="Collapsed"/>
        <MenuItem x:Name="QueriesSaveItem" Header="Сохранить в библиотеку" Click="QueriesSave_Click" InputGestureText="Ctrl+S"
                  Visibility="Collapsed"/>
        <MenuItem x:Name="QueriesCloseItem" Header="Закрыть вкладку" Click="QueriesClose_Click" InputGestureText="Ctrl+W"
                  Visibility="Collapsed"/>
        <MenuItem x:Name="QueriesConnectionsItem" Header="Подключения…" Click="QueriesConnections_Click"
                  Visibility="Collapsed"/>
        <Separator/>
        <MenuItem Header="Настройки…" Click="Settings_Click"/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem x:Name="GitMenu" Header="Git">
        <MenuItem Header="Sync" Click="Sync_Click"/>
        <MenuItem Header="Pull" Click="Pull_Click"/>
        <MenuItem Header="Новая ветка…" Click="NewBranch_Click"/>
        <MenuItem Header="Переключить ветку…" Click="SwitchBranch_Click"/>
        <MenuItem Header="Статус" Click="Status_Click"/>
      </MenuItem>
      <MenuItem x:Name="PrMenu" Header="PR">
        <MenuItem Header="Create PR…" Click="CreatePr_Click"/>
        <MenuItem Header="Auto Pull Request" Click="AutoPr_Click"/>
      </MenuItem>
      <MenuItem Header="Вид">
        <MenuItem Header="Цветовая схема">
          <MenuItem x:Name="ThemeDarkItem" Header="Тёмная" IsCheckable="True" Click="ThemeDark_Click"/>
          <MenuItem x:Name="ThemeLightItem" Header="Светлая" IsCheckable="True" Click="ThemeLight_Click"/>
          <MenuItem x:Name="ThemeGtaItem" Header="GTA VI · Vice City" IsCheckable="True" Click="ThemeGta_Click"/>
        </MenuItem>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel LastChildFill="True">
      <StackPanel Orientation="Horizontal">
        <RadioButton Content="Репозиторий" IsChecked="True" GroupName="Section"
                     Style="{StaticResource SectionButton}" Click="RepoSection_Click"/>
        <RadioButton Content="Запросы" GroupName="Section"
                     Style="{StaticResource SectionButton}" Click="QueriesSection_Click"/>
        <Border Width="1" Margin="12,2" Background="{DynamicResource BorderBrush}"/>
      <StackPanel x:Name="RepoToolbar" Orientation="Horizontal">
        <TextBlock Text="Файлы" VerticalAlignment="Center" Margin="4,0,6,0"
                   Foreground="{DynamicResource FgMutedBrush}"/>
        <Button Content="📄 Новый скрипт" Click="NewScript_Click" Style="{StaticResource ToolbarButton}"/>
        <Button Content="💾 Сохранить" Click="Save_Click" Style="{StaticResource ToolbarButton}"/>
        <Border Width="1" Margin="12,2" Background="{DynamicResource BorderBrush}"/>
        <TextBlock Text="Git" VerticalAlignment="Center" Margin="4,0,6,0"
                   Foreground="{DynamicResource FgMutedBrush}"/>
        <Button Content="↻ Sync" Click="Sync_Click" Style="{StaticResource ToolbarButton}"
                ToolTip="Подтянуть файлы текущей ветки"/>
        <Button Content="↓ Pull" Click="Pull_Click" Style="{StaticResource ToolbarButton}"
                ToolTip="git pull текущей ветки. Без push и без обновления остальных веток"/>
        <Button Content="⎇ Новая ветка" Click="NewBranch_Click" Style="{StaticResource ToolbarButton}"/>
      </StackPanel>
      </StackPanel>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Height="32">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal" Margin="4,0,8,0">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
            <Ellipse.Fill>
              <SolidColorBrush Color="#3DDC97"/>
            </Ellipse.Fill>
          </Ellipse>
          <TextBlock x:Name="StatusText" Text="Готов" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
            <TextBlock.Foreground>
              <SolidColorBrush Color="#3DDC97"/>
            </TextBlock.Foreground>
          </TextBlock>
        </StackPanel>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="BranchStatusText" Text="ветка: —" Foreground="{DynamicResource StatusTextBrush}"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="AuthStatusText" Text="вход: —" Foreground="{DynamicResource StatusTextBrush}"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="{DynamicResource EncodingText}" Foreground="{DynamicResource StatusTextBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
    <queries:QueriesView x:Name="Queries" Visibility="Collapsed"/>
    <Grid x:Name="RepoArea">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="280" MinWidth="200"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="120"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="140" MinHeight="72"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource BackdropBrush}">
          <Border DockPanel.Dock="Top"
                  MinHeight="32"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1">
            <Grid>
              <TextBlock x:Name="EmptyTabsText"
                         Text="{DynamicResource NoTabsLabel}"
                         Margin="10,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource FgMutedBrush}"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalAlignment="Stretch">
                <StackPanel x:Name="FileTabStrip" Orientation="Horizontal"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <avalonEdit:TextEditor x:Name="SqlEditor"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 ShowLineNumbers="True"
                                 WordWrap="False"
                                 Background="{DynamicResource GlassBgBrush}"
                                 Foreground="{DynamicResource FgBrush}"
                                 LineNumbersForeground="{DynamicResource LineNumbersBrush}"/>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{DynamicResource BorderBrush}"/>

        <DockPanel Grid.Row="2" Background="{DynamicResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LogHeader}" FontFamily="{DynamicResource HeaderFontFamily}" FontWeight="SemiBold" Margin="8,6,8,2"
                     Foreground="{DynamicResource FgBrush}"/>
          <RichTextBox x:Name="LogBox"
                       IsReadOnly="True"
                       IsDocumentEnabled="False"
                       BorderThickness="0"
                       Background="{DynamicResource BgBrush}"
                       Foreground="{DynamicResource FgBrush}"
                       CaretBrush="{DynamicResource FgBrush}"
                       FontFamily="Consolas"
                       FontSize="12"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{DynamicResource BorderBrush}"/>

      <Grid x:Name="RightColumn" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="80"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="360" MinHeight="220"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="{DynamicResource PanelBrush}">
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ProjectHeader}" FontFamily="{DynamicResource HeaderFontFamily}" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{DynamicResource FgBrush}"/>
          <TreeView x:Name="ProjectTree"
                    Background="Transparent"
                    Padding="2,2,0,4"
                    MouseDoubleClick="ProjectTree_MouseDoubleClick"
                    PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                    PreviewKeyDown="ProjectTree_PreviewKeyDown">
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Создать файл" Click="CreateFileFromTree_Click"/>
                <MenuItem Header="Создать папку" Click="CreateFolderFromTree_Click"/>
                <Separator/>
                <MenuItem Header="Удалить" Click="DeleteFromTree_Click"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" Background="{DynamicResource BorderBrush}"/>

        <DockPanel Grid.Row="2" Background="{DynamicResource PanelBrush}">
          <Border DockPanel.Dock="Top" Padding="8,8,8,0">
            <Button Click="QuickAdd_Click"
                    Style="{StaticResource QuickAddButton}"
                    HorizontalAlignment="Stretch"
                    ToolTip="Вставить несколько SQL и разложить по папкам">
              <TextBlock Text="⚡ Быстрое добавление" VerticalAlignment="Center"/>
            </Button>
          </Border>
          <Border x:Name="TestAutoPrHost" DockPanel.Dock="Top" Padding="8,8,8,0" Visibility="Collapsed">
            <Button x:Name="TestAutoPrButton" Click="TestAutoPr_Click"
                    Height="36" Margin="0" Padding="10,4"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource SecondaryButton}"
                    ToolTip="Проверить шаблон Telegram без git и без создания PR">
              <TextBlock Text="Test Auto Pull Request" VerticalAlignment="Center"/>
            </Button>
          </Border>
          <Border DockPanel.Dock="Top" Padding="8,8,8,8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Button x:Name="AutoPrButton" Click="AutoPr_Click"
                    Height="36" Margin="0" Padding="10,4"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    ToolTip="{DynamicResource AutoPrTip}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <Path Width="6" Height="6" Stretch="Uniform" Fill="{DynamicResource AccentGlowBrush}" Margin="3,0,0,7"
                      VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <TextBlock Text="Auto Pull Request" Margin="8,0" VerticalAlignment="Center"/>
                <Path Width="6" Height="6" Stretch="Uniform" Fill="{DynamicResource AccentGlowBrush}" Margin="0,7,3,0"
                      VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"
                      Data="M6,0 L7.1,4.4 L11.5,5.5 L7.1,6.6 L6,11 L4.9,6.6 L0.5,5.5 L4.9,4.4 Z"/>
              </StackPanel>
            </Button>
          </Border>
          <TextBlock DockPanel.Dock="Top" Text="ВЕТКА / PR" FontFamily="{DynamicResource HeaderFontFamily}" FontWeight="SemiBold" Margin="8,8,8,4"
                     Foreground="{DynamicResource FgBrush}"/>
          <StackPanel DockPanel.Dock="Top" Margin="8,0,8,8">
            <TextBlock Text="Ветка" Foreground="{DynamicResource FgMutedBrush}"/>
            <Grid Margin="0,4,0,0">
              <ToggleButton x:Name="BranchButton"
                            Style="{StaticResource BranchPickerButton}"
                            IsChecked="{Binding IsOpen, ElementName=BranchPopup, Mode=TwoWay}"
                            ToolTip="Переключить текущую ветку">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" Text="▴" Margin="8,0,0,0"
                             VerticalAlignment="Center" Foreground="{DynamicResource FgMutedBrush}"/>
                  <TextBlock x:Name="BranchButtonText" Text="—" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                </DockPanel>
              </ToggleButton>
              <Popup x:Name="BranchPopup"
                     PlacementTarget="{Binding ElementName=BranchButton}"
                     Placement="Custom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     PopupAnimation="None"
                     Opened="BranchPopup_Opened">
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="8"
                        MinWidth="{Binding ActualWidth, ElementName=BranchButton}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Поиск" Margin="0,0,0,4"
                               Foreground="{DynamicResource FgMutedBrush}"/>
                    <TextBox x:Name="BranchSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             TextChanged="BranchSearchBox_TextChanged"/>
                    <Grid Height="260">
                      <TreeView x:Name="BranchTree"
                                BorderThickness="0"
                                Background="{DynamicResource PanelAltBrush}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                SelectedItemChanged="BranchTree_SelectedItemChanged"/>
                      <TextBlock x:Name="BranchEmptyText" Text="нет веток"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed"
                                 Foreground="{DynamicResource FgMutedBrush}"/>
                    </Grid>
                  </DockPanel>
                </Border>
              </Popup>
            </Grid>
            <TextBlock x:Name="SideBaseText" Text="от: —" Margin="0,4,0,0"
                       Foreground="{DynamicResource FgMutedBrush}"/>
            <Button Content="{DynamicResource CreatePrLabel}" Click="CreatePr_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="Изменения:" Margin="8,0,8,4"
                     Foreground="{DynamicResource FgMutedBrush}"/>
          <Grid>
            <TextBlock x:Name="NoChangesText"
                       Text="{DynamicResource NoChangesLabel}"
                       Margin="8,4"
                       Foreground="{DynamicResource FgMutedBrush}"/>
            <TreeView x:Name="ChangesTree"
                      Background="Transparent"
                      Padding="2,2,0,4"
                      MouseDoubleClick="ChangesTree_MouseDoubleClick"/>
          </Grid>
        </DockPanel>
      </Grid>
    </Grid>
    </Grid>
  </DockPanel>
</Window>
